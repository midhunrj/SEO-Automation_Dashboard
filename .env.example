# ==========================================
# EdgeLink SEO Automation Dashboard - Environment Configuration
# ==========================================

# Mock Toggle Switch (Required by Assessment Specification Section 2.2)
# Set to 'true' to run end-to-end with mock crawlers (PageSpeed, GSC, DataForSEO, Twilio)
# Set to 'false' when connecting real API credentials in production
USE_MOCKS=true

# Database Layer (Supabase / Neon PostgreSQL via Prisma)
# Free tier from https://neon.tech or https://supabase.com
DATABASE_URL="postgresql://username:password@ep-cool-project.region.aws.neon.tech/neondb?sslmode=require"

# Job Queue Layer (BullMQ + Redis)
# Free serverless Redis from https://upstash.com (500K free commands/month)
UPSTASH_REDIS_URL="rediss://default:your_upstash_token@your-endpoint.upstash.io:6379"
REDIS_URL="rediss://default:your_upstash_token@your-endpoint.upstash.io:6379"

# AI Analysis Engine (Anthropic Claude API)
# Get free starter credit at https://console.anthropic.com
# If omitted or USE_MOCKS=true, high-quality structured fallback audit is generated
ANTHROPIC_API_KEY="sk-ant-api03-your-anthropic-key"

# Optional External API Keys (Mocks are used by default)
PAGESPEED_API_KEY=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_NUMBER="whatsapp:+14155238886"

# App Settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"
PORT=3000
